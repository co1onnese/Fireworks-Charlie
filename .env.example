# Database Configuration
DB_URL=postgresql://user:password@localhost/trainer_charlie

# API Keys - Data Collection
EODHD_API_KEY=your_eodhd_key_here
FRED_API_KEY=your_fred_key_here
FINNHUB_API_KEY=your_finnhub_key_here
FMP_API_KEY=your_fmp_key_here
NEWSAPI_KEY=your_newsapi_key_here
SERPAPI_KEY=your_serpapi_key_here

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MAX_TOKENS=128000

# Pipeline Configuration
START_DATE=2024-01-01
END_DATE=2024-12-31
TICKERS=AAPL,NVDA,MSFT,AMZN,META

# Processing Configuration
PARALLEL_WORKERS=2
CHECKPOINT_INTERVAL=1  # Save checkpoint after each day
TOKEN_BUDGET=120000    # Leave room for response

# Directory Configuration
DATA_ROOT=/opt/Trainer-Charlie/data
THESIS_OUTPUT_DIR=/opt/Trainer-Charlie/storage/distilled_theses
CHECKPOINT_DIR=/opt/Trainer-Charlie/storage/checkpoints

# Market Calendar
MARKET_CALENDAR=NYSE

# Logging
LOG_LEVEL=INFO
LOG_FILE=/opt/Trainer-Charlie/logs/trainer_charlie.log