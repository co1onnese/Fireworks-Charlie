# ============================================================================
# Fireworks-Charlie Configuration
# RLVR Training Pipeline for Stock Prediction with GRPO
# ============================================================================

# ====== Database Configuration ======
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fireworks_charlie
DB_USER=fireworks_app
DB_PASSWORD=changeme_secure_password
DB_URL=postgresql://fireworks_app:changeme_secure_password@localhost/fireworks_charlie

# ====== LLM Provider Configuration ======
# Choose which LLM provider to use for thesis generation
# Options: "deepseek" (recommended, direct API) or "fireworks" (for RLVR training)
LLM_PROVIDER=deepseek

# ====== DeepSeek API Configuration (Recommended for Thesis Generation) ======
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-reasoner  # Options: deepseek-chat, deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com
API_TIMEOUT=60  # Timeout in seconds

# ====== Fireworks AI Configuration (For RLVR/GRPO Training Only) ======
FIREWORKS_API_KEY=your_fireworks_key_here
FIREWORKS_ACCOUNT_ID=your_account_id_here

# ====== Model Configuration ======
# General model settings (applies to both providers)
MAX_TOKENS=2048  # Maximum tokens in response
TEMPERATURE=0.7  # Must be > 0 for GRPO exploration

# Fireworks-specific settings (only used when LLM_PROVIDER=fireworks)
MODEL_NAME=accounts/fireworks/models/deepseek-v3p1-terminus
MODEL_MODE=deepseek-chat  # or deepseek-reasoner for thinking mode

# ====== GRPO Training Parameters ======
GRPO_NUM_RESPONSES=4  # Number of responses per prompt (2-8 range)
GRPO_EPOCHS=1
GRPO_LEARNING_RATE=0.0001
GRPO_LORA_RANK=8
GRPO_BATCH_SIZE=32768  # In tokens

# ====== Generation Parameters (Roll-Out) ======
GEN_TEMPERATURE=0.7  # Keep > 0 for exploration
GEN_TOP_P=1.0
GEN_TOP_K=40
GEN_MAX_TOKENS=2048

# ====== API Keys - Data Collection ======
EODHD_API_KEY=your_eodhd_key_here
FRED_API_KEY=your_fred_key_here
FINNHUB_API_KEY=your_finnhub_key_here
FMP_API_KEY=your_fmp_key_here
NEWSAPI_KEY=your_newsapi_key_here
SERPAPI_KEY=your_serpapi_key_here

# ====== Pipeline Configuration ======
START_DATE=2024-01-01
END_DATE=2024-12-31
TICKERS=AAPL,NVDA,MSFT,AMZN,META

# ====== Dataset Time Splits ======
# Training data range (chronological split to prevent data leakage)
TRAIN_START_DATE=2023-10-24
TRAIN_END_DATE=2024-12-31

# Test data range (must be after training end date)
TEST_START_DATE=2025-01-01
TEST_END_DATE=2025-12-31

# ====== Reward Function Weights (must equal 100%) ======
DIRECTIONAL_ACCURACY_WEIGHT=80
SHARPE_RATIO_WEIGHT=20

# ====== RLVR Configuration ======
# RLVR mode is always enabled - no configuration needed
RLVR_OUTPUT_DIR=/opt/Fireworks-Charlie/storage/rlvr_datasets
RLVR_TRAIN_FILE=/opt/Fireworks-Charlie/storage/rlvr_datasets/train.jsonl
RLVR_DEV_FILE=/opt/Fireworks-Charlie/storage/rlvr_datasets/dev.jsonl
RLVR_TEST_FILE=/opt/Fireworks-Charlie/storage/rlvr_datasets/test.jsonl

# Reward function deployment
EVALUATOR_ID=stock-prediction-evaluator
EVALUATOR_NAME=Stock Prediction Verifiable Reward

# ====== Position Management ======
POSITION_HOLD_DAYS=3  # Default hold period in trading days
EARLY_EXIT_ON_SIGNAL_CHANGE=true  # Exit if recommendation changes to hold/sell/strong_sell

# ====== Expected Return Thresholds ======
STRONG_BUY_THRESHOLD=3.0   # Expected >= +3%
BUY_THRESHOLD=2.0          # Expected >= +2%
HOLD_THRESHOLD_LOW=-1.0    # Expected >= -1%
HOLD_THRESHOLD_HIGH=1.0    # Expected <= +1%
SELL_THRESHOLD=-2.0        # Expected <= -2%
STRONG_SELL_THRESHOLD=-3.0 # Expected <= -3%

# ====== Processing Configuration ======
PARALLEL_WORKERS=2
CHECKPOINT_INTERVAL=1  # Save checkpoint after each day
TOKEN_BUDGET=200000    # Increased for comprehensive data analysis
TOKEN_WARNING_THRESHOLD=180000  # Warning when approaching limit

# ====== Directory Configuration ======
DATA_ROOT=/opt/Fireworks-Charlie/data
CHECKPOINT_DIR=/opt/Fireworks-Charlie/storage/checkpoints

# ====== Market Calendar ======
MARKET_CALENDAR=NYSE

# ====== Logging ======
LOG_LEVEL=INFO
LOG_FILE=/opt/Fireworks-Charlie/logs/fireworks_charlie.log
