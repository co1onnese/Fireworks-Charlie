# Fireworks-Charlie Evalprotocol Server Configuration
# Copy this file to .env and configure your environment variables

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Configuration
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432
DB_HOST=localhost
DB_NAME=fireworks_charlie
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_PORT=5432

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server Host and Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Logging Configuration
LOG_LEVEL=info  # debug, info, warning, error, critical

# Worker Configuration (for production)
WORKERS=4

# =============================================================================
# FIREWORKS CONFIGURATION
# =============================================================================

# Fireworks API Credentials (REQUIRED)
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_ACCOUNT_ID=your_fireworks_account_id_here

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Maximum concurrent evaluations
MAX_CONCURRENT_EVALUATIONS=10

# Evaluation timeout in seconds
EVALUATION_TIMEOUT=300

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Origins (comma-separated list or * for all)
CORS_ORIGINS=*

# API Key requirement (true/false)
API_KEY_REQUIRED=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Port
REDIS_PORT=6379

# =============================================================================
# NGINX CONFIGURATION (Production Only)
# =============================================================================

# Nginx Ports
NGINX_PORT=80
NGINX_SSL_PORT=443

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development mode (enables debug features)
DEVELOPMENT_MODE=false

# Hot reload (development only)
RELOAD=false

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Metrics collection (true/false)
ENABLE_METRICS=true

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================

# EODHD API Configuration (for stock data)
EODHD_API_KEY=your_eodhd_api_key_here
EODHD_BASE_URL=https://eodhd.com/api

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Database backup settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# =============================================================================
# ALERTING CONFIGURATION
# =============================================================================

# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Slack alerts (optional)
SLACK_WEBHOOK_URL=

# =============================================================================
# EXAMPLE VALUES FOR QUICK SETUP
# =============================================================================

# For local development, you can use these example values:
# POSTGRES_PASSWORD=dev_password_123
# FIREWORKS_API_KEY=fw_your_api_key_here
# FIREWORKS_ACCOUNT_ID=your_account_id
# LOG_LEVEL=debug
# DEVELOPMENT_MODE=true
# RELOAD=true

# For production, ensure you:
# 1. Use strong, unique passwords
# 2. Set appropriate CORS_ORIGINS
# 3. Enable API_KEY_REQUIRED if needed
# 4. Configure monitoring and alerting
# 5. Set up SSL certificates for HTTPS
